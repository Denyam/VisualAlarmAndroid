<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.example.visualalarm">

    <!-- Permissions -->
    <!-- USE_EXACT_ALARM: special permission, install-time granted for alarm apps -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"
        tools:targetApi="31" />
    <!-- USE_FULL_SCREEN_INTENT: install-time for alarm apps, user can revoke on 34+ -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"
        tools:targetApi="34" />
    <!-- POST_NOTIFICATIONS: runtime on 33+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"
        tools:targetApi="33" />
    <!-- VIBRATE: install-time, for alarm vibration -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- FOREGROUND_SERVICE: required for 34+ foreground service types -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
        tools:targetApi="34" />
    <!-- RECEIVE_BOOT_COMPLETED: to reschedule alarms after reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- SCHEDULE_EXACT_ALARM: not needed with USE_EXACT_ALARM, but safe to declare -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"
        tools:targetApi="31" />

    <application
        android:name=".VisualAlarmApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VisualAlarmAndroid"
        tools:targetApi="31">

        <!-- Main Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.VisualAlarmAndroid">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Alarm Ringing Activity (Full-screen intent target) -->
        <activity
            android:name=".alarm.AlarmActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.VisualAlarmAndroid.Fullscreen">
            <meta-data
                android:name="android.app.lib_name"
                android:value="" />
        </activity>

        <!-- Alarm Receiver: receives the exact alarm trigger -->
        <receiver
            android:name=".alarm.AlarmReceiver"
            android:exported="false"
            android:enabled="true" />

        <!-- Boot/Time Change Receiver: reschedules alarms -->
        <receiver
            android:name=".alarm.BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Ringing Foreground Service -->
        <service
            android:name=".alarm.AlarmRingService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback"
            android:enabled="true" />

    </application>

</manifest>